---
import { Code } from "astro:components"
import { CodeFrame } from "@/components/landing/code-frame"
import { Terminal } from "@/components/landing/terminal"
import Landing from "@/layouts/Landing.astro"
import { markPath, site } from "@/lib/site"

const sdk = `import { createClient } from "@lumbung/client"

const db = createClient({
  url: "http://127.0.0.1:4870",
  token: process.env.LUMBUNG_TOKEN,
  database: "shop",
  branch: "pr-42",
})

const { rows } = await db.query("SELECT * FROM orders")`

const compose = `git clone https://github.com/zakiego/lumbung.git
cd lumbung
docker compose up -d --build`

const tree = [
  { name: "main", meta: "default", root: true },
  { name: "pr-42", meta: "+ index orders_by_email", add: true },
  { name: "agent-sandbox", meta: "expires in 7 days" },
]

const tools = [
  { tool: "create_branch", args: "agent-sandbox" },
  { tool: "execute", args: "ALTER TABLE users ADD plan TEXT" },
  { tool: "diff_branches", args: "1 change against main" },
]

const link =
  "group/link inline-flex items-center gap-1.5 text-[13px] text-muted-foreground transition-colors duration-100 ease-(--ease-out-quad) hover:text-foreground"
const pill = "press inline-flex items-center rounded-full font-[510]"
const primary = `${pill} bg-primary text-primary-foreground hover:bg-primary-hover`
const secondary = `${pill} bg-secondary text-foreground shadow-[inset_0_0_0_1px_var(--hairline)] hover:bg-secondary-hover`
---

<Landing>
  <a
    href="#main"
    class="sr-only z-50 bg-[#5e6ad2] px-4 py-2 text-sm font-[510] text-white focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:rounded-full"
  >
    Skip to content
  </a>

  <header class="sticky top-0 z-40 border-b border-hairline bg-background/80 backdrop-blur-[20px]">
    <div class="mx-auto flex h-16 max-w-6xl items-center px-6">
      <a href="/" class="flex items-center gap-2 rounded text-[15px] font-[590] tracking-[-0.01em]">
        <svg viewBox="0 0 32 32" class="size-5 text-(--mark)" aria-hidden="true" fill="currentColor"><path d={markPath}></path></svg>
        Lumbung
      </a>
      <nav aria-label="Main" class="ml-auto flex items-center gap-1 text-[13px]">
        <a href="/docs/" class="press flex h-8 items-center rounded-full px-3 text-muted-foreground hover:bg-hover hover:text-foreground">Docs</a>
        <a
          href={site.github}
          class="press hidden h-8 items-center rounded-full px-3 text-muted-foreground hover:bg-hover hover:text-foreground sm:flex"
        >
          GitHub <span aria-hidden="true" class="ml-1">↗</span>
        </a>
        <span class="mx-2 h-5 w-px bg-border" aria-hidden="true"></span>
        <a href="/docs/quickstart/" class={`${primary} h-8 px-3 text-[13px]`}>Get started</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="mx-auto grid max-w-6xl items-center gap-12 px-6 pt-14 pb-24 md:pt-24 md:pb-32 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-16">
      <div>
        <h1 class="-ml-0.5 text-[38px] leading-[1.1] font-[510] tracking-[-0.022em] text-balance md:text-[48px] md:leading-[1.08]">
          {site.headline}
        </h1>
        <p class="mt-5 max-w-md text-[15px] leading-relaxed text-muted-foreground md:text-[17px]">{site.description}</p>
        <a href="/docs/quickstart/" class={`${primary} mt-8 h-8 px-3 text-[13px]`}>Get started</a>
      </div>
      <Terminal client:load />
    </section>

    <section aria-label="Features" class="border-t border-hairline">
      <div class="mx-auto grid max-w-6xl px-6 md:grid-cols-2">
        <article class="flex flex-col gap-6 border-b border-hairline py-12 md:border-r md:py-16 md:pr-12">
          <ul class="flex flex-col gap-3 font-mono text-[13px]" aria-label="Branches of the shop database">
            {
              tree.map((b) => (
                <li class:list={["relative flex min-w-0 items-center gap-3", !b.root && "pl-6"]}>
                  {!b.root && <span aria-hidden="true" class="absolute bottom-1/2 left-[4.5px] h-8 w-[19px] rounded-bl-[6px] border-b border-l border-border" />}
                  <span aria-hidden="true" class:list={["relative z-10 size-2.5 shrink-0 rounded-full", b.root ? "bg-foreground" : "border border-muted-foreground bg-background"]} />
                  <span class="shrink-0 text-foreground">{b.name}</span>
                  <span class:list={["min-w-0 text-xs [overflow-wrap:anywhere]", b.add ? "text-success" : "text-muted-foreground"]}>{b.meta}</span>
                </li>
              ))
            }
          </ul>
          <div>
            <h2 class="text-[17px] font-[510] tracking-[-0.012em]">Branches are full copies</h2>
            <p class="mt-1.5 text-[15px] text-muted-foreground">Change one, diff it against main, then throw it away.</p>
          </div>
          <a href="/docs/concepts/branches/" class={link}>Branches <span aria-hidden="true" class="transition-transform duration-100 ease-(--ease-out-quart) motion-safe:group-hover/link:translate-x-0.5">→</span></a>
        </article>

        <article class="flex flex-col gap-6 border-b border-hairline py-12 md:py-16 md:pl-12">
          <ol class="flex flex-col gap-3 font-mono text-[13px]" aria-label="An agent's tool calls">
            {
              tools.map((t) => (
                <li class="flex min-w-0 items-center gap-3">
                  <svg viewBox="0 0 16 16" aria-hidden="true" class="size-3.5 shrink-0 text-success" fill="none" stroke="currentColor" stroke-width="2"><path d="m3.5 8.5 3 3 6-7" /></svg>
                  <span class="shrink-0 text-foreground">{t.tool}</span>
                  <span class="min-w-0 text-xs text-muted-foreground [overflow-wrap:anywhere]">{t.args}</span>
                </li>
              ))
            }
          </ol>
          <div>
            <h2 class="text-[17px] font-[510] tracking-[-0.012em]">Agents get their own branch</h2>
            <p class="mt-1.5 text-[15px] text-muted-foreground">MCP over HTTP, with a token scoped to one branch.</p>
          </div>
          <a href="/docs/guides/ai-agents/" class={link}>Use from an AI agent <span aria-hidden="true" class="transition-transform duration-100 ease-(--ease-out-quart) motion-safe:group-hover/link:translate-x-0.5">→</span></a>
        </article>

        <article class="flex min-w-0 flex-col gap-6 border-b border-hairline py-12 md:border-r md:border-b-0 md:py-16 md:pr-12">
          <CodeFrame client:visible code={sdk} label="TypeScript example" copyLabel="Copy the TypeScript example">
            <Code code={sdk} lang="ts" theme="css-variables" />
          </CodeFrame>
          <div>
            <h2 class="text-[17px] font-[510] tracking-[-0.012em]">Query from TypeScript</h2>
            <p class="mt-1.5 text-[15px] text-muted-foreground">A small client with no dependencies.</p>
          </div>
          <a href="/docs/reference/sdk/" class={link}>TypeScript SDK <span aria-hidden="true" class="transition-transform duration-100 ease-(--ease-out-quart) motion-safe:group-hover/link:translate-x-0.5">→</span></a>
        </article>

        <article class="flex min-w-0 flex-col gap-6 py-12 md:py-16 md:pl-12">
          <CodeFrame client:visible code={compose} label="Install commands" copyLabel="Copy the install commands">
            <Code code={compose} lang="sh" theme="css-variables" />
          </CodeFrame>
          <div>
            <h2 class="text-[17px] font-[510] tracking-[-0.012em]">Runs on your machine</h2>
            <p class="mt-1.5 text-[15px] text-muted-foreground">One Compose file: the engine, the dashboard and your data.</p>
          </div>
          <a href="/docs/self-hosting/docker-compose/" class={link}>Docker Compose <span aria-hidden="true" class="transition-transform duration-100 ease-(--ease-out-quart) motion-safe:group-hover/link:translate-x-0.5">→</span></a>
        </article>
      </div>
    </section>

    <section class="border-t border-hairline px-6 py-28 text-center md:py-40">
      <h2 class="mx-auto max-w-2xl text-[32px] leading-[1.1] font-[510] tracking-[-0.022em] text-balance md:text-[56px]">
        Branch your first database in five minutes
      </h2>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/docs/quickstart/" class={`${primary} h-11 px-5 text-base`}>Get started</a>
        <a href="/docs/" class={`${secondary} h-11 px-5 text-base`}>Read the docs</a>
      </div>
    </section>
  </main>

  <footer class="border-t border-border">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-4 px-6 py-10 text-[13px] text-muted-foreground">
      <span class="flex items-center gap-2 text-foreground">
        <svg viewBox="0 0 32 32" class="size-4 text-(--mark)" aria-hidden="true" fill="currentColor"><path d={markPath}></path></svg>
        Lumbung
      </span>
      <nav aria-label="Footer" class="ml-auto flex flex-wrap gap-x-6 gap-y-2">
        <a href="/docs/" class="transition-colors duration-100 hover:text-foreground">Docs</a>
        <a href="/docs/changelog/" class="transition-colors duration-100 hover:text-foreground">Changelog</a>
        <a href="/llms.txt" class="transition-colors duration-100 hover:text-foreground">llms.txt</a>
        <a href={site.github} class="transition-colors duration-100 hover:text-foreground">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </footer>
</Landing>
