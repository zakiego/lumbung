---
import { Code } from "astro:components"
import { Orbit } from "@/components/landing/orbit"
import { CodeFrame } from "@/components/landing/code-frame"
import { AgentBranch, BranchTree, Clients, Files } from "@/components/landing/feature-graphs"
import Landing from "@/layouts/Landing.astro"
import { markPath, site } from "@/lib/site"

const sdk = `import { createClient } from "@lumbung/client"

const db = createClient({
  url: "http://127.0.0.1:4870",
  token: process.env.LUMBUNG_TOKEN!,
  database: "shop",
  branch: "pr-42",
})

const { rows } = await db.query("SELECT * FROM orders")`

const compose = `git clone https://github.com/zakiego/lumbung.git
cd lumbung
docker compose up -d --build`

const link =
  "group/link -my-1.5 inline-flex items-center gap-1.5 self-start py-1.5 text-[13px] text-muted-foreground transition-[color] duration-100 ease-(--ease-out-quad) hover:text-foreground active:text-foreground"
const pill = "press inline-flex items-center rounded-full font-[510]"
const primary = `${pill} bg-primary text-primary-foreground hover:bg-primary-hover`
const secondary = `${pill} bg-secondary text-foreground shadow-[inset_0_0_0_1px_var(--hairline)] hover:bg-secondary-hover`
---

<Landing>
  <a
    href="#main"
    class="sr-only z-50 bg-ring px-4 py-2 text-sm font-[510] text-white focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:rounded-full"
  >
    Skip to content
  </a>

  <header class="sticky top-0 z-40 border-b border-hairline bg-background/80 backdrop-blur-[20px]">
    <div class="mx-auto flex h-16 max-w-7xl items-center px-6">
      <a href="/" class="flex items-center gap-2 rounded text-[15px] font-[590] tracking-[-0.01em]">
        <svg viewBox="0 0 32 32" class="size-5 text-(--mark)" aria-hidden="true" fill="currentColor"><path d={markPath}></path></svg>
        Lumbung
      </a>
      <nav aria-label="Main" class="ml-auto flex items-center gap-1 text-[13px]">
        <a href="/docs/" class="press flex h-8 items-center rounded-full px-3 text-muted-foreground hover:bg-hover hover:text-foreground">Docs</a>
        <a
          href={site.github}
          class="press hidden h-8 items-center rounded-full px-3 text-muted-foreground hover:bg-hover hover:text-foreground sm:flex"
        >
          GitHub <span aria-hidden="true" class="ml-1">↗</span>
        </a>
        <span class="mx-2 h-5 w-px bg-border" aria-hidden="true"></span>
        <a href="/docs/quickstart/" class={`${primary} h-8 px-3 text-[13px]`}>Get started</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="mx-auto grid max-w-7xl items-center gap-10 px-6 pt-10 pb-20 md:pt-20 md:pb-28 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-16">
      <div>
        <h1 class="-ml-0.5 text-[32px] leading-[1.12] font-[510] tracking-[-0.022em] text-balance md:text-[44px] md:leading-[1.08]">
          {site.headline}
        </h1>
        <p class="mt-4 max-w-md text-[15px] leading-relaxed text-muted-foreground md:mt-5 md:text-[17px]">{site.tagline}</p>
        <a href="/docs/quickstart/" class={`${primary} mt-6 h-8 px-3 text-[13px] md:mt-8`}>Get started</a>
      </div>
      <Orbit client:load />
    </section>

    <section aria-label="Features" class="border-t border-hairline">
      <div class="mx-auto grid max-w-7xl px-6 md:grid-cols-2">
        <article class="flex flex-col gap-6 border-b border-hairline py-12 md:border-r md:py-16 md:pr-12">
          <BranchTree />
          <div>
            <h2 class="text-[17px] font-[510] tracking-[-0.012em]">Branches are full copies</h2>
            <p class="mt-1.5 text-[15px] text-pretty text-muted-foreground">Change one, diff it against main, then throw it away.</p>
          </div>
          <a href="/docs/concepts/branches/" class={link}>Branches <span aria-hidden="true" class="transition-transform duration-100 ease-(--ease-out-quart) motion-safe:group-hover/link:translate-x-0.5">→</span></a>
        </article>

        <article class="flex flex-col gap-6 border-b border-hairline py-12 md:py-16 md:pl-12">
          <AgentBranch />
          <div>
            <h2 class="text-[17px] font-[510] tracking-[-0.012em]">Agents get their own branch</h2>
            <p class="mt-1.5 text-[15px] text-pretty text-muted-foreground">MCP over HTTP, with a token scoped to one branch.</p>
          </div>
          <a href="/docs/guides/ai-agents/" class={link}>Use from an AI agent <span aria-hidden="true" class="transition-transform duration-100 ease-(--ease-out-quart) motion-safe:group-hover/link:translate-x-0.5">→</span></a>
        </article>

        <article class="flex min-w-0 flex-col gap-6 border-b border-hairline py-12 md:border-r md:py-16 md:pr-12">
          <Clients />
          <div>
            <h2 class="text-[17px] font-[510] tracking-[-0.012em]">Works with libSQL clients</h2>
            <p class="mt-1.5 text-[15px] text-pretty text-muted-foreground">Point @libsql/client or Drizzle at a branch URL.</p>
          </div>
          <a href="/docs/guides/libsql/" class={link}>libSQL client <span aria-hidden="true" class="transition-transform duration-100 ease-(--ease-out-quart) motion-safe:group-hover/link:translate-x-0.5">→</span></a>
        </article>

        <article class="flex min-w-0 flex-col gap-6 border-b border-hairline py-12 md:py-16 md:pl-12">
          <Files />
          <div>
            <h2 class="text-[17px] font-[510] tracking-[-0.012em]">Files next to your data</h2>
            <p class="mt-1.5 text-[15px] text-pretty text-muted-foreground">Buckets that any S3 client can read and write.</p>
          </div>
          <a href="/docs/concepts/buckets/" class={link}>Buckets <span aria-hidden="true" class="transition-transform duration-100 ease-(--ease-out-quart) motion-safe:group-hover/link:translate-x-0.5">→</span></a>
        </article>

        <article class="flex min-w-0 flex-col gap-6 border-b border-hairline py-12 md:border-r md:border-b-0 md:py-16 md:pr-12">
          <CodeFrame client:visible code={sdk} label="TypeScript example" copyLabel="Copy the TypeScript example">
            <Code code={sdk} lang="ts" theme="css-variables" />
          </CodeFrame>
          <div>
            <h2 class="text-[17px] font-[510] tracking-[-0.012em]">Query from TypeScript</h2>
            <p class="mt-1.5 text-[15px] text-pretty text-muted-foreground">A small client with no dependencies.</p>
          </div>
          <a href="/docs/reference/sdk/" class={link}>TypeScript SDK <span aria-hidden="true" class="transition-transform duration-100 ease-(--ease-out-quart) motion-safe:group-hover/link:translate-x-0.5">→</span></a>
        </article>

        <article class="flex min-w-0 flex-col gap-6 py-12 md:py-16 md:pl-12">
          <CodeFrame client:visible code={compose} label="Install commands" copyLabel="Copy the install commands">
            <Code code={compose} lang="sh" theme="css-variables" />
          </CodeFrame>
          <div>
            <h2 class="text-[17px] font-[510] tracking-[-0.012em]">Runs on your machine</h2>
            <p class="mt-1.5 text-[15px] text-pretty text-muted-foreground">One Compose file: the engine, the dashboard and your data.</p>
          </div>
          <a href="/docs/self-hosting/docker-compose/" class={link}>Docker Compose <span aria-hidden="true" class="transition-transform duration-100 ease-(--ease-out-quart) motion-safe:group-hover/link:translate-x-0.5">→</span></a>
        </article>
      </div>
    </section>

    {/* Plays each feature graph once, the first time all of it is clear of the fold.
        Rocket Loader would defer this without data-cfasync. */}
    <script is:inline data-cfasync="false">
      ;(() => {
        const graphs = document.querySelectorAll(".fg")
        const seen = (graph) => graph.setAttribute("data-seen", "")
        if (!("IntersectionObserver" in window)) return graphs.forEach(seen)
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue
              seen(entry.target)
              observer.unobserve(entry.target)
            }
          },
          { threshold: 1, rootMargin: "0px 0px -10% 0px" },
        )
        graphs.forEach((graph) => observer.observe(graph))
      })()
    </script>

    <section class="border-t border-hairline px-6 py-28 text-center md:py-40">
      <h2 class="mx-auto max-w-2xl text-[32px] leading-[1.1] font-[510] tracking-[-0.022em] text-balance md:text-[56px]">
        Branch your first database in five minutes
      </h2>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/docs/quickstart/" class={`${primary} h-11 px-5 text-base`}>Get started</a>
        <a href="/docs/" class={`${secondary} h-11 px-5 text-base`}>Read the docs</a>
      </div>
    </section>
  </main>

  <footer class="border-t border-border">
    <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-6 gap-y-4 px-6 py-10 text-[13px] text-muted-foreground">
      <span class="flex items-center gap-2 text-foreground">
        <svg viewBox="0 0 32 32" class="size-4 text-(--mark)" aria-hidden="true" fill="currentColor"><path d={markPath}></path></svg>
        Lumbung
      </span>
      <nav aria-label="Footer" class="ml-auto flex flex-wrap gap-x-6 gap-y-2">
        <a href="/docs/" class="transition-[color] duration-100 hover:text-foreground active:text-foreground">Docs</a>
        <a href="/docs/changelog/" class="transition-[color] duration-100 hover:text-foreground active:text-foreground">Changelog</a>
        <a href="/llms.txt" class="transition-[color] duration-100 hover:text-foreground active:text-foreground">llms.txt</a>
        <a href={site.github} class="transition-[color] duration-100 hover:text-foreground active:text-foreground">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </footer>
</Landing>
