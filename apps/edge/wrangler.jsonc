// Edge router for lumbung.zakiego.com, on Zakiego Lab. Our deployment only:
// nothing in the product depends on it. See src/routing.ts for which paths go
// where. Deploy with the cf-zakiego-lab Wrangler login:
//   pnpm --filter @lumbung/edge deploy:preview   preview on workers.dev, no route
//   pnpm --filter @lumbung/edge deploy           production: takes the route (cutover)
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lumbung-edge",
  "account_id": "4ff140db4fae29f31ae5f481dc6fb6a4",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "lumbung.zakiego.com/*", "zone_name": "zakiego.com" }],
  "vars": {
    // Placeholder until the Pages project exists. Check the real *.pages.dev
    // hostname after creating it (Pages may add a suffix if the name is taken).
    "SITE_ORIGIN": "https://lumbung-site.pages.dev"
  },
  "observability": { "enabled": true },
  "env": {
    // Same code on lumbung-edge-preview.<subdomain>.workers.dev, with no route.
    // A workers.dev request can't fall through to the zone's origin, so app
    // paths go to the live hostname instead (read-only checks only: the
    // dashboard binds sign-in and passkeys to its own origin).
    "preview": {
      "name": "lumbung-edge-preview",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "SITE_ORIGIN": "https://lumbung-site.pages.dev",
        "APP_ORIGIN": "https://lumbung.zakiego.com"
      }
    }
  }
}
