{
  "name": "@lumbung/client",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript client for Lumbung: query, batch and manage self-hosted SQLite databases with branches. No runtime dependencies; works in Node, Bun, Workers and the browser.",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "default": "./dist/drizzle.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "drizzle-orm": "0.45.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
