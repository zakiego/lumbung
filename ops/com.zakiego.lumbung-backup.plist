<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nightly Lumbung backup. A template: ops/install-backup.sh fills in the
  label, the installed script (~/selfhost/bin/lumbung-backup.sh) and the
  selfhost folder (~/selfhost), and installs it in ~/Library/LaunchAgents.
  If the Mac is asleep at 03:30, launchd runs the job when it wakes.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__SCRIPT__</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LUMBUNG_DIR</key>
    <string>__SELFHOST__/lumbung</string>
    <key>BACKUP_DIR</key>
    <string>__SELFHOST__/lumbung-backups</string>
  </dict>
  <!-- The script logs to this file itself; these catch anything before that. -->
  <key>StandardOutPath</key>
  <string>__SELFHOST__/lumbung-backup.log</string>
  <key>StandardErrorPath</key>
  <string>__SELFHOST__/lumbung-backup.log</string>
  <key>RunAtLoad</key>
  <false/>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
