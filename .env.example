# Example settings for Lumbung. Copy this file to `.env` next to compose.yaml
# and change what you need. Never commit the real file.
#
# Docker Compose reads the three values in the first section from `.env` on
# its own. Everything below them is read by lumbungd or the dashboard from
# their environment: set it in your shell when running the binaries, or add it
# under `environment:` in compose.yaml. Every setting is optional and the
# values shown are the defaults. Full reference:
# apps/site/src/content/docs/docs/reference/configuration.mdx and
# apps/site/src/content/docs/docs/reference/dashboard-configuration.md

# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------

# Version string baked into the engine image.
LUMBUNG_VERSION=dev
# The address people open for the dashboard, without /app. Sign-in cookies and
# passkeys bind to it, so behind a proxy set it to the public https address.
LUMBUNG_DASHBOARD_URL=http://localhost:4871
# The engine address shown in connect snippets.
LUMBUNG_PUBLIC_ENGINE_URL=http://localhost:4870

# ---------------------------------------------------------------------------
# Secrets. Leave these unset and they are generated on first start and kept
# in the data folder with mode 600. Set them only to manage them yourself.
# ---------------------------------------------------------------------------

# Instance admin token the dashboard uses to call the engine.
# LUMBUNG_SERVICE_TOKEN=replace-with-a-token-from-lumbungd
# Signs dashboard sessions. At least 32 random characters (openssl rand -hex 32).
# LUMBUNG_AUTH_SECRET=replace-with-at-least-32-random-characters

# ---------------------------------------------------------------------------
# Behind a reverse proxy (the engine and the dashboard both read these)
# ---------------------------------------------------------------------------

# Header with the real client address, such as X-Forwarded-For or CF-Connecting-IP.
# LUMBUNG_CLIENT_IP_HEADER=
# Networks allowed to set that header, comma-separated.
# LUMBUNG_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------

# Where the dashboard reaches the engine. Under Compose, http://engine:4870.
# LUMBUNG_ENGINE_URL=http://127.0.0.1:4870
# File holding the service token, read when LUMBUNG_SERVICE_TOKEN is unset.
# LUMBUNG_SERVICE_TOKEN_FILE=../engine/data/secrets/service-token
# Folder for dashboard.db (users, sessions, passkeys, invites) and its secret.
# LUMBUNG_DASHBOARD_DATA_DIR=./data
# Extra origins that accept password sign-in, comma-separated.
# LUMBUNG_DASHBOARD_EXTRA_ORIGINS=

# ---------------------------------------------------------------------------
# Engine (lumbungd)
# ---------------------------------------------------------------------------

# Folder for meta.db, branch files, snapshots, objects and generated secrets. Use a local disk.
# LUMBUNG_DATA_DIR=./data
# Address the HTTP server listens on.
# LUMBUNG_ADDR=127.0.0.1:4870
# Longest a query or batch may run.
# LUMBUNG_STATEMENT_TIMEOUT=30s
# How long a statement waits for a lock held by another connection before failing with busy.
# LUMBUNG_BUSY_TIMEOUT=5s
# Most rows one statement may return.
# LUMBUNG_MAX_RESULT_ROWS=10000
# Most bytes of values one request may return, counted across all its statements.
# LUMBUNG_MAX_RESULT_BYTES=16MiB
# Largest JSON request body.
# LUMBUNG_MAX_REQUEST_BYTES=32MiB
# Most bound parameters in one statement.
# LUMBUNG_MAX_PARAMS=10000
# Largest single string or blob a statement may create.
# LUMBUNG_MAX_VALUE_BYTES=16MiB
# Longest statement text.
# LUMBUNG_MAX_SQL_BYTES=1MiB
# Largest a branch file may grow.
# LUMBUNG_MAX_BRANCH_BYTES=1GiB
# Total size of all branch files.
# LUMBUNG_MAX_INSTANCE_BYTES=10GiB
# New databases, branches, snapshots and imports are refused with HTTP 507 below this much free disk.
# LUMBUNG_MIN_FREE_DISK=2GiB
# Most databases on the instance, in every workspace together, counting ones in the trash.
# LUMBUNG_MAX_DATABASES=100
# Most branches in one database.
# LUMBUNG_MAX_BRANCHES=50
# How long a deleted database stays in the trash, restorable, before its files are removed.
# LUMBUNG_TRASH_RETENTION=168h
# Largest .db file or SQL dump an import accepts.
# LUMBUNG_MAX_IMPORT_BYTES=1GiB
# Longest an import may run, in place of the statement timeout.
# LUMBUNG_IMPORT_TIMEOUT=10m
# Requests per second each token may make, on average.
# LUMBUNG_RATE_LIMIT=50
# Requests a token may make at once before the rate limit applies.
# LUMBUNG_RATE_BURST=100
# Failed authentications allowed per client address per minute.
# LUMBUNG_AUTH_FAILURES_PER_MINUTE=20
# Queries slower than this go to the branch's slow-query log (the newest 50 are kept).
# LUMBUNG_SLOW_QUERY=1s
# How long per-minute branch stats are kept.
# LUMBUNG_STATS_RETENTION=48h
# Most audit log entries kept per workspace, and for the instance's own actions.
# LUMBUNG_AUDIT_MAX_ROWS=100000
# Read-only connections kept per open branch, next to its one writer.
# LUMBUNG_READERS_PER_BRANCH=4
# Most branches with open connections at once.
# LUMBUNG_MAX_OPEN_BRANCHES=64
# A branch unused this long has its connections closed.
# LUMBUNG_IDLE_CONN_TIMEOUT=5m
# Memory ceiling for each SQLite connection.
# LUMBUNG_CONN_MAX_MEMORY=128MiB
# A libSQL protocol stream idle this long is closed and its open transaction rolled back.
# LUMBUNG_LIBSQL_STREAM_IDLE_TIMEOUT=10s
# Longest an interactive libSQL protocol transaction may stay open, from its BEGIN.
# LUMBUNG_LIBSQL_TX_TIMEOUT=60s
# Most open libSQL protocol streams on the instance.
# LUMBUNG_LIBSQL_MAX_STREAMS=128
# Most open libSQL protocol streams per token.
# LUMBUNG_LIBSQL_MAX_STREAMS_PER_TOKEN=16
# Most buckets on the instance, in every workspace together.
# LUMBUNG_MAX_BUCKETS=100
# Largest object, sent in one piece or assembled from a multipart upload.
# LUMBUNG_MAX_OBJECT_BYTES=5GiB
# Most bytes one bucket may hold, counting its multipart uploads in progress.
# LUMBUNG_MAX_BUCKET_BYTES=10GiB
# Most bytes all buckets together may hold, counting multipart uploads in progress.
# LUMBUNG_MAX_OBJECT_STORAGE_BYTES=20GiB
# A multipart upload not completed this long after it started is aborted.
# LUMBUNG_MULTIPART_EXPIRY=24h
# Longest a presigned URL may stay valid.
# LUMBUNG_PRESIGN_MAX_EXPIRY=168h
# Requests per second each client address may make without a token, to read public buckets.
# LUMBUNG_PUBLIC_RATE_LIMIT=100
# How long the file of a replaced or deleted object is kept before removal.
# LUMBUNG_OBJECT_GC_DELAY=1h
# Most workspaces on the instance, counting ones in the trash.
# LUMBUNG_MAX_WORKSPACES=100
# Most live tokens one workspace may hold.
# LUMBUNG_MAX_TOKENS_PER_WORKSPACE=1000
# Default database limit for a new workspace (0: none).
# LUMBUNG_WORKSPACE_MAX_DATABASES=20
# Default bucket limit for a new workspace (0: none).
# LUMBUNG_WORKSPACE_MAX_BUCKETS=20
# Default limit on a new workspace's total branch file size (0: none).
# LUMBUNG_WORKSPACE_MAX_DATABASE_BYTES=2GiB
# Default limit on a new workspace's total object size (0: none).
# LUMBUNG_WORKSPACE_MAX_OBJECT_BYTES=5GiB
